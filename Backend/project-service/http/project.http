# Public requests go through the gateway. Supply real tokens and UUIDs privately.
@baseUrl = http://localhost:8080

### Create from a Proposal snapshot that includes the approved creation plan
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json
Idempotency-Key: create-approved-project-001

{"proposalId":"{{proposalId}}","approvalId":"{{approvalId}}"}

### Read project / ETag
GET {{baseUrl}}/api/v1/projects/{{projectId}}
Authorization: Bearer {{userToken}}

### Create activity using the project's current ETag
POST {{baseUrl}}/api/v1/projects/{{projectId}}/activities
Authorization: Bearer {{userToken}}
Content-Type: application/json
If-Match: {{projectEtag}}
Idempotency-Key: add-calibration-001

{
  "name":"Calibrate field sensors",
  "responsibleUserId":"{{researcherId}}",
  "startDate":"2026-12-01",
  "deadline":"2027-01-01",
  "weight":10
}

### Change activity status using its own ETag
POST {{baseUrl}}/api/v1/projects/{{projectId}}/activities/{{activityId}}/transitions
Authorization: Bearer {{userToken}}
Content-Type: application/json
If-Match: {{activityEtag}}

{"targetStatus":"IN_PROGRESS"}

### Read calculated progress
GET {{baseUrl}}/api/v1/projects/{{projectId}}/progress
Authorization: Bearer {{userToken}}

### Associate a version-pinned final report
PUT {{baseUrl}}/api/v1/projects/{{projectId}}/final-report
Authorization: Bearer {{userToken}}
Content-Type: application/json
If-Match: {{projectEtag}}

{"documentId":"{{documentId}}","documentVersion":1}

### Close only after completing work and submitting a validated final report
POST {{baseUrl}}/api/v1/projects/{{projectId}}/transitions
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json
If-Match: {{projectEtag}}

{"targetStatus":"CLOSED","reason":"Closure requirements verified"}
