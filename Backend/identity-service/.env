PORT=8081
DATABASE_URL=jdbc:postgresql://identity-postgres:5432/identity_db
SPRING_DATASOURCE_USERNAME=identity
SPRING_DATASOURCE_PASSWORD=identity_dev_password

# Replace with your actual issuer URL, reachable from inside Docker.
OIDC_ISSUER_URI=http://localhost:8180/realms/investitrack
OIDC_AUDIENCE=research-platform-api
OIDC_INTERNAL_AUDIENCE=identity-service

# Disable RabbitMQ publishing for initial local development.
OUTBOX_ENABLED=false

# First startup on an empty database: use your real IdP user details.
IDENTITY_BOOTSTRAP_SUBJECT=08c3e582-2ec5-42c4-ad9a-2965134efb34
IDENTITY_BOOTSTRAP_EMAIL=admin@investitrack.local
IDENTITY_BOOTSTRAP_NAME=Administrator
OIDC_JWK_SET_URI=http://localhost:8180/realms/investitrack/protocol/openid-connect/certs
