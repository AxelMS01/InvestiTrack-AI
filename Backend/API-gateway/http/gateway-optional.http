# First PUT uses projectEtag as reportEtag; subsequent PUT uses GET final-report ETag. Requires Document and delegation.
PUT {{baseUrl}}/api/v1/projects/{{projectId}}/final-report
Authorization: Bearer {{researcherToken}}
If-Match: {{reportEtag}}
Content-Type: application/json

{
  "documentId": "{{documentId}}",
  "documentVersion": 1
}

> {%
client.test("Project: PUT /api/v1/projects/{projectId}/final-report", function () {
    client.assert(response.status >= 200 && response.status < 300, "Unexpected HTTP status: " + response.status);
});
if (response.status >= 200 && response.status < 300) {
    const etag = response.headers.valueOf("ETag");
    if (etag) client.global.set("reportEtag", etag);
}
%}


