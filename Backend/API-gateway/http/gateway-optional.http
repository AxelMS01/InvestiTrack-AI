### Identity: POST /api/v1/users
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "identitySubject": "{{newIdentitySubject}}",
  "institutionalId": "HTTP-TEST-001",
  "email": "http-test@university.example",
  "displayName": "HTTP Test User",
  "roles": [
    "RESEARCHER"
  ]
}

> {%
client.test("Identity: POST /api/v1/users", function () {
    client.assert(response.status >= 200 && response.status < 300, "Unexpected HTTP status: " + response.status);
});
if (response.status >= 200 && response.status < 300) {
    const etag = response.headers.valueOf("ETag");
    if (etag) client.global.set("managedUserEtag", etag);
    if (response.body.id) client.global.set("managedUserId", response.body.id);
}
%}


