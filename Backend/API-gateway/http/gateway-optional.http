# Optional endpoint catalog: run individual requests in a valid resource state.
# Run gateway.http first to capture resource IDs, and select the local environment.
# Refresh GET resource ETags before mutations. These requests include deletion and
# deactivation; they are examples, not an ordered workflow. Do not use Run All.
# Evidence/report requests require the Document service, which is not implemented here.
@baseUrl = http://localhost:8080

# Optional endpoint catalog. Run individually in a valid resource state.
# Destructive requests are last. Read the owning resource immediately before a mutation.


### Identity: PATCH /api/v1/me
PATCH {{baseUrl}}/api/v1/me
Authorization: Bearer {{researcherToken}}
If-Match: {{profileEtag}}
Content-Type: application/json

{
  "displayName": "HTTP Client Researcher",
  "locale": "es-MX"
}

> {%
client.test("Identity: PATCH /api/v1/me", function () {
    client.assert(response.status >= 200 && response.status < 300, "Unexpected HTTP status: " + response.status);
});
if (response.status >= 200 && response.status < 300) {
    const etag = response.headers.valueOf("ETag");
    if (etag) client.global.set("profileEtag", etag);
}
%}


