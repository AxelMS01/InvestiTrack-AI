### Negative check: missing If-Match. Expected: 428.
# Coordinator is authorized to attempt a transition; the precondition check runs first.
POST {{baseUrl}}/api/v1/proposals/{{proposalId}}/transitions
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{"targetStatus": "REJECTED"}

> {%
client.test("Negative check: missing If-Match. Expected: 428.", function () { client.assert(response.status === 428, "Expected 428"); });
%}

### Project: create from the approved Proposal snapshot
# Requires Project workload credentials for Proposal snapshot reads and Identity status checks.
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "proposalId": "{{proposalId}}",
  "approvalId": "{{approvalId}}"
}

> {%
client.test("Project: create from the approved Proposal snapshot", function () {
    client.assert(response.status >= 200 && response.status < 300, "Unexpected HTTP status: " + response.status);
});
if (response.status >= 200 && response.status < 300) {
    const etag = response.headers.valueOf("ETag");
    if (etag) client.global.set("projectEtag", etag);
    if (response.body.id) client.global.set("projectId", response.body.id);
}
%}


