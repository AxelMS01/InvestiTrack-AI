# IntelliJ HTTP Client: run in order after python3 scripts/refresh-http-env.py --setup.
# All API requests use the gateway; tokens are issued separately by Keycloak.
# Copy http-client.env.json.example to http-client.private.env.json in this directory,
# fill in tokens and application UUIDs, then select the local environment.
# .env configures Spring/Docker; IntelliJ HTTP Client does not load it automatically.
# Tokens require research-platform-api audience and the matching signed role.
# Identity must also contain active profiles with those roles; evaluator != researcher.
# First run Identity profile requests, then Proposal steps 2-18, then Project workflow.
# Optional requests live in gateway-optional.http; refresh the owning resource's
# ETag before every mutation, including after adding/removing children.
# --setup seeds development catalogs and configures local workload credentials.
# Assignment/approval/member checks need IDENTITY_SERVICE_TOKEN in the owning services.
# Project creation needs PROPOSAL_SERVICE_TOKEN; document writes need Document + delegation.
# Missing dependencies can return 503 even when liveness reports UP.
@baseUrl = http://localhost:8080


### Identity: administrator profile
GET {{baseUrl}}/api/v1/me
Authorization: Bearer {{adminToken}}

> {%
client.test("Identity: administrator profile", function () {
    client.assert(response.status >= 200 && response.status < 300, "Unexpected HTTP status: " + response.status);
});
%}


### Identity: researcher profile and application UUID
GET {{baseUrl}}/api/v1/me
Authorization: Bearer {{researcherToken}}

> {%
client.test("Identity: researcher profile and application UUID", function () {
    client.assert(response.status >= 200 && response.status < 300, "Unexpected HTTP status: " + response.status);
});
if (response.status >= 200 && response.status < 300) {
    const etag = response.headers.valueOf("ETag");
    if (etag) client.global.set("profileEtag", etag);
    if (response.body.id) client.global.set("researcherId", response.body.id);
}
%}


