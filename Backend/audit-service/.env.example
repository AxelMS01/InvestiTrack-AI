PORT=8087
DATABASE_URL=jdbc:postgresql://localhost:5432/audit_db
DATABASE_USERNAME=audit_runtime
DATABASE_PASSWORD=
# For a separate migration owner, export Spring's standard variables:
# SPRING_FLYWAY_USER=audit_owner
# SPRING_FLYWAY_PASSWORD=
# Alternatively run migrations separately and set SPRING_FLYWAY_ENABLED=false.
OIDC_ISSUER_URI=http://localhost:8180/realms/investitrack
OIDC_JWK_SET_URI=http://localhost:8180/realms/investitrack/protocol/openid-connect/certs
OIDC_AUDIENCE=research-platform-api
OIDC_INTERNAL_AUDIENCE=audit-service
IDENTITY_SERVICE_URL=http://localhost:8081
# Audit workload token with identity-service audience and identity:status scope.
IDENTITY_SERVICE_TOKEN=
JOBS_ENABLED=true
MESSAGING_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=audit
RABBITMQ_PASSWORD=
