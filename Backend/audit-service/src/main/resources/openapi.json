        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,200}$"
            }
          }
        ],
        "description": "Captures current maximum ingestion sequence. Maximum 10000 matching events and 10 MiB CSV; larger exports fail with EXPORT_TOO_LARGE. Artifacts expire in 24 hours. Replays return the original response."
      }
    },
