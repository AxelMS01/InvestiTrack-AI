{
  "openapi": "3.0.3",
  "info": {
    "title": "InvestiTrack Audit Service",
    "version": "1.0.0",
    "description": "Append-only audit history, private asynchronous CSV exports, and trusted idempotent ingestion. All public reads require a current administrator or institution-wide auditor. No public API creates or mutates audit events. Raw producer payloads are never retained in the database."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
