  "components": {
    "schemas": {
      "Actor": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "USER",
              "SERVICE",
              "SYSTEM"
            ]
          },
          "id": {
            "type": "string",
            "maxLength": 255
          }
        },
        "required": [
          "type",
          "id"
        ]
      },
      "Resource": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,49}$"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "type"
        ]
      },
      "Outcome": {
        "type": "string",
        "enum": [
          "SUCCESS",
          "FAILURE",
          "DENIED"
        ]
      },
      "AuditFilters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actorId": {
            "type": "string",
            "maxLength": 255
          },
          "action": {
            "type": "string",
            "maxLength": 255
          },
          "resourceType": {
            "type": "string",
            "maxLength": 255
          },
          "resourceId": {
            "type": "string",
            "maxLength": 255
          },
          "projectId": {
            "type": "string",
            "maxLength": 255
          },
          "outcome": {
            "type": "string",
            "maxLength": 255
          },
          "from": {
            "type": "string",
            "maxLength": 255
          },
          "to": {
            "type": "string",
            "maxLength": 255
          },
          "correlationId": {
            "type": "string",
            "maxLength": 255
          },
          "sourceService": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "AuditEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sequenceNumber": {
            "type": "integer",
            "format": "int64"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "$ref": "#/components/schemas/Actor"
          },
          "action": {
            "type": "string"
          },
          "resource": {
            "$ref": "#/components/schemas/Resource"
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "correlationId": {
            "type": "string"
          },
          "sourceService": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "description": "Only allowlisted UUIDs, codes, dates, counters and role codes. No raw text, credentials or signed URLs."
          },
          "previousHash": {
            "type": "string",
            "nullable": true
          },
          "eventHash": {
            "type": "string"
          }
        }
      },
      "ExportInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filters"
        ],
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/AuditFilters"
          }
        }
      },
      "ExportJob": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "requestedBy": {
            "type": "string",
            "format": "uuid"
          },
          "filterDefinition": {
            "$ref": "#/components/schemas/AuditFilters"
          },
          "upperSequence": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "COMPLETED",
              "FAILED",
              "EXPIRED"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "CSV"
            ]
          },
          "recordCount": {
            "type": "integer",
            "nullable": true
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "failureCode": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "DownloadAuthorization": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "url",
          "expiresAt"
        ]
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "eventId",
          "accepted"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int64"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "correlationId"
        ]
      },
      "AuditInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "$ref": "#/components/schemas/Actor"
          },
          "action": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,99}$"
          },
          "resource": {
            "$ref": "#/components/schemas/Resource"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "correlationId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,100}$"
          },
          "metadata": {
            "type": "object",
            "maxProperties": 100,
            "additionalProperties": true
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "actor",
          "action",
          "resource",
          "outcome",
          "correlationId"
        ]
      },
      "AuditPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            }
          },
          "page": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "hasMore": {
                "type": "boolean"
              },
              "nextCursor": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
